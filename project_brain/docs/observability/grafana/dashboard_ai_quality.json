{
  "uid": "nama-ai-quality",
  "title": "NamaMedical — AI Quality & Drift",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "tags": ["nama","ai","governance"],
  "panels": [
    {
      "id": 1, "type": "stat", "title": "AI calls (24h)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(increase(ai_calls_total[24h]))" }]
    },
    {
      "id": 2, "type": "stat", "title": "Avg confidence (24h)",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "avg_over_time(ai_confidence_avg[24h])" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 1,
        "thresholds": { "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0.7 }, { "color": "green", "value": 0.85 }] } } }
    },
    {
      "id": 3, "type": "stat", "title": "Human override rate",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "100 * sum(rate(ai_human_override_total[1h])) / sum(rate(ai_calls_total[1h]))" }],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "id": 4, "type": "stat", "title": "Hallucination incidents (30d)",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(increase(ai_hallucination_incidents_total[30d]))" }]
    },
    {
      "id": 5, "type": "timeseries", "title": "Latency p50/p95/p99",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, sum by (le) (rate(ai_orchestrator_latency_seconds_bucket[5m])))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(ai_orchestrator_latency_seconds_bucket[5m])))", "legendFormat": "p95" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(ai_orchestrator_latency_seconds_bucket[5m])))", "legendFormat": "p99" }
      ]
    },
    {
      "id": 6, "type": "timeseries", "title": "ECG STEMI sensitivity (rolling KSA cohort)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "ecg_stemi_sensitivity_rolling" }]
    },
    {
      "id": 7, "type": "table", "title": "Subgroup performance gaps",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 8 },
      "targets": [{ "expr": "ai_subgroup_performance_gap" }]
    }
  ]
}
