{
  "uid": "nama-platform",
  "title": "NamaMedical — Platform Overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "tags": ["nama","platform"],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(http_requests_total{job=~\".+-api\"}, job)",
        "includeAll": true, "multi": true
      }
    ]
  },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Tier-1 Uptime (30d)",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{
        "expr": "100 * avg_over_time(probe_success{tier=\"1\"}[30d])",
        "refId": "A"
      }],
      "fieldConfig": { "defaults": { "unit": "percent",
        "thresholds": { "mode": "absolute",
          "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 99.5 }, { "color": "green", "value": 99.9 }] } } }
    },
    {
      "id": 2, "type": "stat", "title": "Active Sev1",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "sum(ALERTS{severity=\"sev1\",alertstate=\"firing\"})" }]
    },
    {
      "id": 3, "type": "timeseries", "title": "Request rate (RPS)",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum by (job) (rate(http_requests_total{job=~\"$service\"}[1m]))",
        "legendFormat": "{{job}}"
      }]
    },
    {
      "id": 4, "type": "timeseries", "title": "p95 latency (s)",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_request_duration_seconds_bucket{job=~\"$service\"}[5m])))",
        "legendFormat": "{{job}}"
      }]
    },
    {
      "id": 5, "type": "timeseries", "title": "5xx error rate (%)",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "100 * sum by (job) (rate(http_requests_total{status=~\"5..\"}[5m])) / sum by (job) (rate(http_requests_total{job=~\"$service\"}[5m]))",
        "legendFormat": "{{job}}"
      }]
    },
    {
      "id": 6, "type": "timeseries", "title": "MSSQL connections",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "targets": [{
        "expr": "mssql_connections_count"
      }]
    }
  ]
}
