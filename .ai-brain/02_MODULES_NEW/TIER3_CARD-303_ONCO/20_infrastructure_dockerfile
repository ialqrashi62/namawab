FROM node:20-alpine
LABEL module="TIER3_CARD-303_ONCO"
LABEL department="Cardio-Oncology"

WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production

COPY tier3_card_303_onco_engine.js ./
COPY 09_router.js ./coo_router.js

ENV NODE_ENV=production
ENV PORT=3203

EXPOSE 3203
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s \
  CMD wget -qO- http://localhost:3203/api/coo/health || exit 1

CMD ["node", "coo_router.js"]
