# filepath: .ai-brain/07-devops/docker/Dockerfile.backend
# NamaMedical Backend - Generated 2026-08-08
FROM node:20-alpine
WORKDIR /app
COPY package*.json ./
RUN npm ci --only=production
COPY . .
EXPOSE 3000
USER node
CMD ["node", "server.js"]
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O - http://localhost:3000/health || exit 1
