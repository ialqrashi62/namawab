# filepath: .ai-brain/07-devops/docker/Dockerfile.frontend
# NamaMedical Frontend (Nginx) - Generated 2026-08-08
FROM nginx:alpine
COPY namaweb/public /usr/share/nginx/html
COPY .ai-brain/07-devops/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s CMD wget -q -O - http://localhost/ || exit 1
