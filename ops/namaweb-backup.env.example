# =============================================================================
# NamaMedical ERP — PostgreSQL connection template for ops/cron scripts
# =============================================================================
# File:         /var/www/namaweb/ops/namaweb-backup.env.example
# Purpose:      Reference template for the runtime env file used by
#               ops/cron_install.sh. Real values live ONLY in
#               /etc/namaweb-backup.env on the production host.
#
# Install:      sudo bash /var/www/namaweb/ops/cron_install.sh
#               (the installer copies this template to /etc/namaweb-backup.env
#                and chmod 600's it; you then edit the real password in place)
#
# Manual:       sudo cp /var/www/namaweb/ops/namaweb-backup.env.example \
#                     /etc/namaweb-backup.env
#               sudo chmod 600 /etc/namaweb-backup.env
#               sudoedit  /etc/namaweb-backup.env   # replace __CHANGE_ME__
#
# Security:     This template may live in the ops/ folder because every
#               secret is the literal string __CHANGE_ME__. AGENTS.md §2.2
#               rail 1 (no real secrets in tracked files) is preserved.
#
# Read at:      Runtime, by ops/cron scripts and the cron jobs in
#               /etc/cron.d/namaweb-ops. Never embedded in scripts or
#               the crontab itself.
# =============================================================================

# -----------------------------------------------------------------------
# PostgreSQL connection — used by pg_dump + psql health probes
# -----------------------------------------------------------------------
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nama_medical
PGUSER=nama_medical_app

# PGPASSWORD is the ONLY secret. It is set ONLY in /etc/namaweb-backup.env
# (chmod 600, root:root), never in this template, never in a script,
# never in /etc/cron.d/*. Replace __CHANGE_ME__ with the real password.
PGPASSWORD=__CHANGE_ME__

# -----------------------------------------------------------------------
# Backup retention (days) — older *.sql.gz files are deleted
# -----------------------------------------------------------------------
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------
# Backup output directory — created by cron_install.sh if missing
# -----------------------------------------------------------------------
BACKUP_DIR=/var/backups/namaweb
