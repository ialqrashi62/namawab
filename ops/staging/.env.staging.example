# .env.staging.example — TEMPLATE for the isolated Jumanasoft staging environment.
# Copy to namaweb/.env.staging on the STAGING host and fill real values there. NEVER commit real secrets.
# Hard rule: this file must NEVER point at production (nama_medical_web) or the live jumanasoft.com DB.

# --- Environment ---
NODE_ENV=staging
PORT=3010
APP_PUBLIC_URL=https://staging.jumanasoft.com

# --- Database (ISOLATED staging only) ---
DB_HOST=<staging_db_host>            # NOT the production host
DB_PORT=5432
DB_NAME=jumanasoft_staging           # MUST be jumanasoft_staging (never nama_medical_web)
DB_USER=jumanasoft_staging_user      # NOSUPERUSER, NOBYPASSRLS, staging-only grants
DB_PASSWORD=<set_on_staging_host>    # real value set on host only; never in git
DB_MAX_CONNECTIONS=10

# --- SaaS feature flags (start safe) ---
SUPER_ADMIN_ENABLED=false            # enable later with SUPER_ADMIN_USERS when validating the panel
SUPER_ADMIN_USERS=
ENTITLEMENTS_ENABLED=false           # Runbook 4B turns this to true in OBSERVE only, after validate+seed
ENTITLEMENTS_ENFORCEMENT_MODE=observe
ENTITLEMENTS_FAIL_MODE=allow_existing

# --- Session/secrets (generate fresh for staging; do NOT reuse production values) ---
SESSION_SECRET=<generate_unique_for_staging>
# Redis (separate from production if used):
# REDIS_URL=<staging_redis_or_leave_unset>
