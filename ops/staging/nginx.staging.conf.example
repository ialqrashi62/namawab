# nginx.staging.conf.example — reverse proxy for staging.jumanasoft.com -> staging app (port 3010).
# TEMPLATE — DevOps installs on the staging host. Must NOT route to the production app or production DB.
# Recommended: gate behind basic auth or an IP allowlist; serve over HTTPS.

server {
    listen 443 ssl;
    server_name staging.jumanasoft.com;

    # ssl_certificate     /etc/letsencrypt/live/staging.jumanasoft.com/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/staging.jumanasoft.com/privkey.pem;

    # Access restriction (pick one): basic auth OR IP allowlist.
    auth_basic "Jumanasoft Staging";
    auth_basic_user_file /etc/nginx/.htpasswd_staging;   # htpasswd-managed; no secrets in git
    # allow 203.0.113.0/24;  deny all;                    # alternative: IP allowlist

    add_header X-Robots-Tag "noindex, nofollow" always;

    location / {
        proxy_pass http://127.0.0.1:3010;   # staging app ONLY (never production upstream)
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# DNS: point staging.jumanasoft.com -> the staging host IP (NOT the production/live jumanasoft.com IP).
