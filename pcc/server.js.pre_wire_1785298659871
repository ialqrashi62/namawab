  // eslint-disable-next-line no-console
  console.log(`PCC ${sig} received, shutting down`);
  server.close(async () => {
    try { await closeDb(); } catch (_) { /* ignore */ }
    process.exit(0);
  });
  setTimeout(() => process.exit(1), 5000).unref();
}
