# NamaMedical — deploy/restore script environment (PLACEHOLDERS ONLY)
# Copy to a local, git-ignored .env and fill with real values from your secret store.
# NEVER commit real secret values. These vars are consumed by the *.sh deploy/restore scripts.

# Microsoft SQL Server 'sa' password (used by configure_sql.sh, fix_ldap.sh, restore_db.sh)
MSSQL_SA_PASSWORD=__CHANGE_ME__

# PostgreSQL password for the 'namasoft' app user (setup_server.sh, deploy_web.sh)
DB_PASSWORD=__CHANGE_ME__

# Full PostgreSQL connection string used by the app (deploy_web.sh writes this into the app .env)
DATABASE_URL=postgresql://namasoft:__CHANGE_ME__@localhost:5432/namasoft

# Application JWT signing secret (deploy_web.sh)
JWT_SECRET=__CHANGE_ME__

# Application session secret (deploy_web.sh) — generate with: openssl rand -base64 48
SESSION_SECRET=__CHANGE_ME__
