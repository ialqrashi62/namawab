# ============================================================
# .env.staging.example  —  قالب بيئة staging (بدون أسرار)
# انسخه إلى namaweb/.env.staging (مُتجاهَل في git) واملأ القيم محلياً فقط.
# لا تضع أي سر حقيقي هنا ولا ترفعه إلى git.
# ============================================================

# قاعدة staging المعزولة — يجب أن تختلف عن الإنتاج (nama_medical_web @ 5432)
DB_HOST=localhost
# الخيار المفضّل: عنقود/حاوية منفصلة على منفذ مختلف
DB_PORT=5433
DB_NAME=nama_medical_staging_rehearsal
DB_USER=postgres
DB_PASSWORD=        # املأ محلياً فقط — لا تلتزمه في git
DB_MAX_CONNECTIONS=10

# إعدادات الخادم
PORT=3001
SESSION_SECRET=    # placeholder — ولّد قيمة محلية، لا تلتزمها

# يجب ألا تكون production أبداً على staging
NODE_ENV=staging
