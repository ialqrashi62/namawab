# NamaMedical — example environment vars (copy to .env and fill)
# DO NOT COMMIT real .env files.

# ─── Core ──────────────────────────────────────────────────────────
NAMA_ENV=local                 # local | staging | prod
LOG_LEVEL=INFO                 # DEBUG | INFO | WARN | ERROR

# ─── Database (MSSQL primary) ──────────────────────────────────────
DATABASE_URL=mssql+pyodbc://sa:NamaDev!2026@localhost/master?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

# ─── Vector / cache / queue / blob ────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
REDIS_URL=redis://:NamaDev!2026@localhost:6379
KAFKA_BROKERS=localhost:9092
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=nama
MINIO_SECRET_KEY=NamaDev!2026
MINIO_BUCKET=nama-blobs

# ─── Auth ──────────────────────────────────────────────────────────
OIDC_ISSUER=https://idp.nama.local/realms/nama
OIDC_AUDIENCE=nama-api
JWT_PUBLIC_KEY_URL=https://idp.nama.local/.well-known/jwks.json

# ─── AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
NAMA_LLM_MODEL=claude-opus-4-7
NAMA_LLM_FAST=claude-haiku-4-5-20251001
AI_LANG_DEFAULT=ar
CONFIDENCE_THRESHOLD=0.7
PHI_REDACTION=strict
LLM_REGION=ksa

# ─── KSA platform integrations ─────────────────────────────────────
NPHIES_BASE=https://nphies.sa
NPHIES_CLIENT_ID=
NPHIES_CLIENT_SECRET=
WASFATY_BASE=https://wasfaty.moh.gov.sa
ZATCA_BASE=https://gw-fatoora.zatca.gov.sa
ZATCA_CERT_PATH=/run/secrets/zatca.pfx
YAQEEN_BASE=https://yaqeen.moh.gov.sa

# ─── Observability ─────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ai-orchestrator
PROMETHEUS_ENABLED=true

# ─── Misc ──────────────────────────────────────────────────────────
SENTRY_DSN=
PAGERDUTY_INTEGRATION_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=+9665XXXXXXXX
